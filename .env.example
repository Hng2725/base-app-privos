# Runtime mode is auto-detected (@privos_ai/app-server resolveRuntimeMode), never set by env:
#   managed              — PRIVOS_WORKLOAD_SOCKET is mounted by the platform (below).
#   standalone-production — a paired identity file exists (see `npm run pair:standalone`,
#                            PRIVOS_STANDALONE_IDENTITY_FILE below).
#   development           — neither is present, and NODE_ENV is not production.
# Both a socket and an identity file present is a fatal startup error; NODE_ENV=production with
# neither is also a fatal startup error — there is no unsigned-production fallback.

# Local development compatibility (`npm run dev` / `npm run start:relay`). Cached by the pairing
# prompt; never use these in a managed or standalone production installation.
# PRIVOS_URL=http://localhost:3000
# CLIENT_ID=
# CLIENT_SECRET=

# Vite iframe development
# DEV_TUNNEL=localhost
# VITE_PORT=5179
# PUBLIC_URL=

# Standalone production (self-hosted against a portal-less Hub). Pair once with
# `npm run pair:standalone`, then `npm run start:standalone` loads the identity file below.
# PRIVOS_STANDALONE_IDENTITY_FILE=./privos-standalone-identity.json
# PORT=3000

# Managed production transport. The platform supplies only non-secret identity bindings and
# mounts the per-installation socket; do not set OAuth secrets.
# PORT=3000
# PRIVOS_HUB_ORIGIN=https://workspace.example.com
# PRIVOS_APP_ID=ai.privos.mcp-app-demo
# PRIVOS_INSTALLATION_ID=
# PRIVOS_WORKLOAD_SOCKET=/run/privos/identity.sock

# Platform-injected license/workspace metadata (never a long-lived OAuth secret).
# PRIVOS_APP_LICENSE=
# PRIVOS_WORKSPACE_ID=

# HR mail delivery (EmailJS). Without these, hrm.mail.send fails with a clear configuration
# error and nothing else in the dashboard is affected.
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=      # only when the EmailJS service enforces strict mode

# This app's own installation agent-bot credential — issued by a workspace admin from the app's
# settings page. Required by the two server-side features that must work with no browser session
# attached: the hrm.payroll.* passthrough and the room email history (see src/hub-tool-call.ts).
# PRIVOS_AGENT_BOT_USER_ID=
# PRIVOS_AGENT_BOT_CREDENTIAL=

# Cached by the development pairing loop alongside the relay credentials; every backend Hub call
# carries it in its body. Re-pair if it is missing.
# MCP_APP_ID=
